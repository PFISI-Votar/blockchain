# Sepolia testnet.
SEPOLIA_RPC_URL=completar_con_alchemy_instructivo_en_repo_blockchain
PRIVATE_KEY=private_key
ADMIN_MULTISIG_ADDRESS=multisig_address

# VOTAR-347 — operational wallet granted PAUSER_ROLE on every election created by
# ElectionFactory. Distinct from ADMIN_MULTISIG_ADDRESS: this is the backend's own
# wallet (same address that back/ derives from its PRIVATE_KEY), used to execute
# pause()/unpause() once the Autoridad Electoral's app-level confirmation flow
# reaches the required threshold. NEVER reuse a single unaccountable EOA for this
# without the backend's n-of-m confirmation gate in front of it.
# setup-sepolia.ts writes this automatically; do not leave the placeholder.
PAUSER_OPERATOR_ADDRESS=

# VOTAR-377 — "Entidad de Firmas Digitales" (Tercero de Confianza). Address granted
# VALIDATOR_ROLE on every BallotContract created by ElectionFactory. It MUST be the
# address of the backend VALIDATOR_PRIVATE_KEY: the contract rejects any vote whose
# institutional signature does not recover to a holder of this role.
VALIDATOR_ADDRESS=

# US-335 — MerkleRootStore
MERKLE_ROOT_STORE_ADDRESS=ejecutar_deploy-sepolia-stack.ts_repo_blockchain



#
#OTRAS VARIABLES (útiles en deploy, dejar vacías para develop)
#

# Optional: admin account private key — needed for full Sepolia UAT script (UAT-01, UAT-03, UAT-04). Never commit the real value.
# ADMIN_PRIVATE_KEY=

# Optional: reuse an already-deployed contract instead of redeploying
# CONTRACT_ADDRESS=

# US-335 — MerkleRootStore
# MERKLE_UPDATER_ADDRESS=   # backend wallet granted MERKLE_UPDATER_ROLE

# VOTAR-341 — VoteRegistry revote policy (default false = strict uniqueness)
# REVOTE_ENABLED=false

# VOTAR-324 — BallotContract max signed votes per voter (default 1)
# MAX_VOTES_PER_VOTER=1

# VOTAR-325 — BallotContract minimum cooldown (seconds) between signed votes (default 0 = disabled)
# MIN_INTERVAL_SECONDS=0

# VOTAR-337 / VOTAR-385 — ElectionFactory + Sepolia stack deploy + Etherscan verification
# ETHERSCAN_API_KEY=        # https://etherscan.io/apidashboard (V2 key works for Sepolia)
# SKIP_VERIFY=true          # optional: skip automatic verify after deploy

# VOTAR-385 — resilient Sepolia stack deploy (npm run deploy:sepolia:stack)
# DEPLOY_MAX_ATTEMPTS=5     # RPC / mempool retries
# GAS_BUMP_PERCENT=20       # EIP-1559 fee bump per retry attempt
# DEPLOY_RETRY_DELAY_MS=2000
# ABI_EXPORT_BACK_DIR=      # override default ../back/src/blockchain/abis
# ABI_EXPORT_FRONT_DIR=     # override default ../front/src/lib/blockchain/abis
# SKIP_ABI_EXPORT_BACK=true
# SKIP_ABI_EXPORT_FRONT=true

# VOTAR-386 — nodos RPC de respaldo (Infura / Alchemy / QuickNode). Failover < 1s, rotación en 429.
# Opcional: setup-sepolia.ts también puede pedirlo al arrancar. Vacío = solo el nodo principal.
# SEPOLIA_RPC_FALLBACK_URLS=https://sepolia.infura.io/v3/KEY,https://xxxx.quiknode.pro/KEY
