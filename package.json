{
  "name": "votar-blockchain",
  "version": "0.1.0",
  "description": "VOTAR on-chain smart contracts (RBAC AccessControl + electoral ecosystem)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:cov": "hardhat coverage",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:merkle-store:sepolia": "hardhat run scripts/deploy-merkle-root-store.ts --network sepolia",
    "deploy:ballot:sepolia": "hardhat run scripts/deploy-ballot-contract.ts --network sepolia",
    "deploy:registry:sepolia": "hardhat run scripts/deploy-vote-registry.ts --network sepolia",
    "deploy:audit-view:sepolia": "hardhat run scripts/deploy-audit-view.ts --network sepolia",
    "uat:335:sepolia": "hardhat run scripts/sepolia-uat-335.ts --network sepolia",
    "uat:339:sepolia": "hardhat run scripts/sepolia-uat-339.ts --network sepolia",
    "uat:350": "hardhat run scripts/uat-audit-views.ts",
    "audit:votecast": "hardhat run scripts/audit-votecast.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "js-sha3": "^0.9.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
